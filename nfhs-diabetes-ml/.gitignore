# Project Data & Models (Keep folder structure via .gitkeep, ignore data & model binaries)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

reports/figures/*
!reports/figures/.gitkeep
reports/tables/*
!reports/tables/.gitkeep
